# Скопируйте на сервере в /opt/health-ai-web/site.env и заполните.
# Читается контейнером сайта. Выкатка этот файл не трогает.
#
# Переменных с префиксом NEXT_PUBLIC_ здесь нет намеренно: Next подставляет
# их в код на сборке, а не читает при старте. Они задаются аргументами
# сборки образа (.github/workflows/deploy.yml).

# Адрес API вместе с версией пути. Сайт ходит в API своим сервером, поэтому
# наружу этот адрес не попадает — можно указывать и внутренний.
API_BASE_URL=https://health-api.avavion.ru/v1

# Как часто перепроверяются правовые документы, секунды. Час: редакция
# меняется несколько раз в год, а ISR всё равно перепроверяет ответ по ETag.
LEGAL_REVALIDATE_SECONDS=3600

# Идентификатор «устройства» самого сайта: им подписаны запросы без человека —
# чтение правовых документов при пересборке страницы (§15.1). Постоянный
# UUID; у стенда и прода он должен быть разным, иначе они делят счётчик
# лимитов на чтение документов.
#
#   uuidgen | tr '[:upper:]' '[:lower:]'
SITE_DEVICE_ID=
