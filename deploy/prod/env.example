# Скопируйте на сервере в /opt/health-ai-web/.env и заполните.
# Этот файл читает docker compose, когда подставляет значения в
# docker-compose.yml. Настройки самого сайта живут в site.env.
#
# Файл создаётся один раз руками. Выкатка его не трогает.

# Домен сайта. Compose его не использует — по нему выкатка проверяет, что
# снаружи отвечает новая версия. Сертификат выпускает Caddy на хосте.
DOMAIN=healthai.avavion.ru

# Порт на петле, по которому сайт виден хостовому Caddy. Наружу не смотрит.
# 3100, а не 3000: на 3000 на этой машине уже сидит панель наблюдения.
#
#   sudo ss -ltnp 'sport = :3100'
#
# Поменяв значение, поправьте адрес в секции сайта в /etc/caddy/Caddyfile:
# Caddy стоит на хосте и .env не читает.
WEB_PORT=3100
