# Скопируйте на сервере в /opt/health-ai-web/.env и заполните.
# Этот файл читает docker compose, когда подставляет значения в
# docker-compose.yml, и читают скрипты выкатки. Настройки самого сайта живут
# в site.env.
#
# Файл создаётся один раз руками. Выкатка его не трогает.

# Домен сайта. Compose его не использует — по нему выкатка проверяет, что
# после переключения снаружи отвечает новая версия. Сертификат выпускает
# Caddy на хосте, ему адрес известен из своей секции.
DOMAIN=healthai.avavion.ru

# Порты цветов на петле. Наружу не смотрят.
#
# 3000 и 3001 на этой машине заняты: 3000 держит панель наблюдения
# (GRAFANA_PORT в /opt/health-ai/.env), 3001 — сосед. Прежде чем менять
# значения, посмотрите, что порт свободен:
#
#   sudo ss -ltnp 'sport = :3110'
#   sudo ss -ltnp 'sport = :3111'
#
# Поменяв, поправьте и секцию сайта в /etc/caddy/Caddyfile: адрес живого
# цвета туда пишет выкатка, но диапазон портов Caddy знать неоткуда —
# он живёт на хосте и .env не читает.
WEB_PORT_BLUE=3110
WEB_PORT_GREEN=3111
