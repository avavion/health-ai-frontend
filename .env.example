# Адрес API вместе с версией пути. Сайт ходит в API своим сервером, поэтому
# адрес в браузер не попадает и публичным быть не обязан.
#
#   разработка  http://localhost:8080/v1   (docker compose бэкенда)
#   прод        https://health-api.avavion.ru/v1
API_BASE_URL=http://localhost:8080/v1

# Адрес самого сайта. Уходит в канонические ссылки и в карту сайта.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Почта поддержки, показывается на странице поддержки и в подвале.
NEXT_PUBLIC_SUPPORT_EMAIL=support@healthai.app

# Как часто перепроверяются правовые документы, секунды. Час: редакция
# меняется несколько раз в год, а ISR всё равно перепроверяет ответ по ETag.
LEGAL_REVALIDATE_SECONDS=3600

# Версия сайта. Уходит в X-App-Version и видна в списке устройств (§4.4).
NEXT_PUBLIC_APP_VERSION=0.1.0 (web)

# Идентификатор «устройства» самого сайта: им подписаны запросы без человека —
# чтение правовых документов при пересборке страницы. Постоянный UUID, у
# стенда и прода он может быть разным, чтобы не делить счётчик лимитов.
SITE_DEVICE_ID=00000000-0000-4000-8000-000000000001
